pipeline {
    agent any
    
    tools{
        go '1.26'
    }
    environment{
        GO111MODULE = 'on'
        DOCKERHUB_CREDS = credentials('docker-hub-credentials')
    }

    stages {
        stage('Test') {
            steps {
                // git branch: "${env.BRANCH_NAME}", url: 'https://github.com/cordonezjolon/book-golang-api.git'
                sh 'make test'
            }
        }
        stage('Build our image'){
            steps{
                script {
                    def branch = env.GIT_BRANCH.replaceFirst(/^origin\//, '').replaceAll('/', '-')
                    app = docker.build("${DOCKERHUB_CREDS_USR}/books-go-api:${branch}-${env.BUILD_NUMBER}")
                }
            }
        }
        stage('Push our image'){
            steps{
                script {
                    docker.withRegistry('https://registry.hub.docker.com', 'docker-hub-credentials') {
                        app.push()
                        app.push("latest")
                    }
                }
            }
        }
        // stage('Run our image'){
        //     steps{
        //         script {
        //             app.run('-p 8080:8080')
        //         }
        //     }
        // }
    }
}